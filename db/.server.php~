if (isset($_SESSION['LAST_ACTIVITY']) && (time() - $_SESSION['LAST_ACTIVITY'] > 180)) {
    // Session expired
    session_unset();
    session_destroy();
}
$_SESSION['LAST_ACTIVITY'] = time(); // Update last activity timestamp

