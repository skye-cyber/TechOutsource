<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Therapeutic</title>
    <script src='../src/js/packed_animator.js'></script>
    <link rel="stylesheet" href="../src/css/styles.css">
  </head>
  <body class="bg-gradient-to-br from-blue-50 via-purple-400 to-pink-200 flex items-center justify-center min-h-screen animate-gradientSlow bg-[length:200%_200%]">

    <div class="relative bg-white/60 backdrop-blur-lg shadow-lg rounded-2xl p-8 w-full max-w-md" data-aos="fade-up" data-aos-duration="800">
      <h2 class="text-3xl font-extrabold text-center mb-6 text-blue-700" data-aos="zoom-in" data-aos-delay="200">
        Welcome Back
      </h2>
          <!-- Theme Toggle Switch -->
      <div class="absolute top-2 right-0 flex items-center hidden">
          <label class="relative inline-block w-10 h-6 cursor-pointer select-none ml-4">
              <input type="checkbox" id="theme-toggle-sm" class="peer hidden" onclick="document.getElementById('theme-toggle').click()">
              <span
                  class="absolute inset-0 bg-gray-400 peer-checked:bg-sky-500 transition rounded-full"
              ></span>
              <span
                  class="absolute left-0 bottom-0.5 w-5 h-5 bg-white rounded-full transition peer-checked:translate-x-5"
              ></span>
          </label>

          <span class="text-teal-950 font-bold dark:text-gray-200 ml-2"></span>
      </div>

      <form class="space-y-6">
        <div class="relative" data-aos="fade-right" data-aos-delay="300">
          <label for="email" class="absolute -top-3 left-4 bg-white/10 px-1 text-sm text-gray-600 rounded-md">Email/Username</label>
          <input type="email" id="email" placeholder="you@example.com / user1"
                 class="peer w-full px-4 py-3 border-2 border-blue-200 rounded-xl focus:outline-none focus:ring-0 focus:border-blue-400 transition-colors" />
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-400 peer-focus:w-full transition-all duration-500"></span>
        </div>
        <div class="relative" data-aos="fade-left" data-aos-delay="300">
          <label for="password" class="absolute -top-3 left-4 bg-white/10 px-1 text-sm text-gray-600">Password</label>
          <input type="password" id="password" placeholder="Enter your password"
                 class="peer w-full px-4 py-3 border-2 border-blue-200 rounded-xl focus:outline-none focus:ring-0 focus:border-blue-400 transition-colors" />
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-400 peer-focus:w-full transition-all duration-500 delay-150"></span>
        </div>
        <button type="submit"
                class="w-full bg-blue-400 text-white py-3 rounded-xl hover:bg-blue-500 transform hover:scale-105 transition-all duration-300">
          Login
        </button>
      </form>
      <p class="text-center text-gray-600 mt-4" data-aos="fade-up" data-aos-delay="500">
        Don't have an account?
        <a href="signup.html" class="text-blue-500 hover:underline">Sign Up</a>
      </p>
    </div>
  </body>
</html>

