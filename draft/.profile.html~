<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile - Therapeutic</title>
    <script src='../src/js/themes.js'></script>
    <script src='../src/js/packed_animator.js'></script>
    <link rel="stylesheet" href="../src/css/styles.css">
  </head>
  <body class="bg-gradient-to-br from-pink-100 via-orange-50 to-blue-100 dark:bg-gradient-to-br dark:from-blue-900 dark:via-purple-800 dark:to-pink-900 flex items-center justify-center min-h-screen bg-[length:200%_200%] animate-gradientTransition">

    <!-- Theme Toggle Switch -->
    <div class="absolute top-4 right-6 z-10 select-none">
      <label class="relative inline-block w-12 h-7 cursor-pointer">
        <input type="checkbox" id="theme-toggle" class="peer sr-only">
        <span class="block w-full h-full bg-gray-300 rounded-full peer-checked:bg-indigo-400 transition-colors"></span>
        <span class="absolute top-0.5 left-0.5 w-6 h-6 bg-white rounded-full shadow transform transition-transform peer-checked:translate-x-5"></span>
      </label>
    </div>

    <!-- Profile Card -->
    <div
      class="bg-white dark:bg-gray-800 bg-opacity-80 dark:bg-opacity-80 border border-white/30 dark:border-gray-700 rounded-2xl p-8 w-full max-w-lg backdrop-blur-md shadow-lg transition-all duration-1000 hover:scale-[1.02]"
      data-aos="zoom-in"
      data-aos-duration="800"
    >
      <div class="flex flex-col items-center" data-aos="fade-down" data-aos-delay="150">
        <div
          class="w-24 h-24 bg-gradient-to-tr from-purple-300 to-pink-300 dark:from-indigo-600 dark:to-purple-600 rounded-full flex items-center justify-center shadow-md transition-all transform duration-700 hover:rotate-6"
        >
          <span class="text-3xl font-semibold text-white transition-colors duration-1000">U</span>
        </div>
        <h2 class="mt-4 text-2xl font-bold text-gray-800 dark:text-gray-100 transition-colors duration-1000">John Doe</h2>
        <p class="text-gray-600 dark:text-gray-300 text-sm transition-colors duration-1000">john.doe@example.com</p>
      </div>

      <div class="mt-6 space-y-3" data-aos="fade-up" data-aos-delay="300">
        <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Profile Details</h3>
        <p class="text-gray-600 dark:text-gray-300 transition-colors duration-1000"><strong>Bio:</strong> Passionate about tech & innovation.</p>
        <p class="text-gray-600 dark:text-gray-300 transition-colors duration-1000"><strong>Skills:</strong> Web Dev, Python, Tailwind</p>
        <p class="text-gray-600 dark:text-gray-300 transition-colors duration-1000"><strong>Location:</strong> Nairobi, Kenya</p>
      </div>

      <div class="mt-6 flex justify-center gap-4" data-aos="fade-up" data-aos-delay="450">
        <a
          href="edit-profile.html"
          class="px-5 py-2 bg-indigo-400 text-white rounded-full hover:bg-indigo-500 transition-colors duration-300"
        >Edit</a>
        <a
          href="login.html"
          class="px-5 py-2 bg-red-400 text-white rounded-full hover:bg-red-500 transition-colors duration-300"
        >Logout</a>
      </div>
    </div>

  </body>

</html>

