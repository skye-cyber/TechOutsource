<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile - Therapeutic</title>

    <link rel="stylesheet" href="styles.css">
  </head>
  <body class="bg-gradient-to-br from-indigo-100 to-blue-200 flex items-center justify-center min-h-screen">
    <div class="bg-white shadow-md rounded-lg p-8 w-full max-w-lg">
      <div class="flex flex-col items-center">
        <div class="w-24 h-24 bg-gray-300 rounded-full flex items-center justify-center">
          <!-- User profile picture placeholder -->
          <span class="text-2xl text-white">U</span>
        </div>
        <h2 class="mt-4 text-3xl font-bold text-gray-800">John Doe</h2>
        <p class="text-gray-600">john.doe@example.com</p>
      </div>
      <div class="mt-6">
        <h3 class="text-xl font-semibold text-gray-700 mb-3">Profile Details</h3>
        <p class="text-gray-600 mb-2"><strong>Bio:</strong> Passionate about technology and innovation.</p>
        <p class="text-gray-600 mb-2"><strong>Skills:</strong> Web Development, Python, Tailwind CSS</p>
        <p class="text-gray-600 mb-2"><strong>Location:</strong> Nairobi, Kenya</p>
      </div>
      <div class="mt-6 flex justify-between">
        <a href="edit-profile.html" class="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition duration-300">Edit Profile</a>
        <a href="login.html" class="px-4 py-2 bg-red-500 text-white rounded-md hover:bg-red-600 transition duration-300">Logout</a>
      </div>
    </div>
  </body>
</html>

